{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "@type": "tm:ThingModel",
  "title": "Stand control",
  "titles": {
    "en": "Stand control",
    "ru": "Управление стендом"
  },
  "description": "Written by akt-web only; each command is an object with a growing seq.",
  "version": {
    "model": "1.0.0"
  },
  "links": [
    {
      "rel": "tm:submodel",
      "href": "http://akt-models/tm/q-obj-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "scenario"
    },
    {
      "rel": "tm:submodel",
      "href": "http://akt-models/tm/q-obj-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "speed"
    },
    {
      "rel": "tm:submodel",
      "href": "http://akt-models/tm/q-obj-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "reset"
    },
    {
      "rel": "tm:submodel",
      "href": "http://akt-models/tm/q-obj-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "cancel"
    },
    {
      "rel": "tm:submodel",
      "href": "http://akt-models/tm/q-text-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "idSimulationRun"
    },
    {
      "rel": "tm:submodel",
      "href": "http://akt-models/tm/q-min-1.0.0.tm.jsonld",
      "type": "application/tm+json",
      "instanceName": "sim_time"
    }
  ],
  "properties": {
    "_parents": {
      "type": "string",
      "title": "Parent thing",
      "description": "thingId of the parent: the tree and the Telegraf tag parent."
    },
    "_isType": {
      "type": "boolean",
      "default": false,
      "description": "false: an instance, not a type (Grafana OpenTwins app)."
    },
    "type": {
      "type": "string",
      "description": "Thing type, same as the model file name.",
      "default": "control"
    },
    "name": {
      "type": "string",
      "description": "Display name (Grafana OpenTwins app)."
    },
    "name_ru": {
      "type": "string",
      "description": "Name in Russian."
    },
    "passport": {
      "type": "object",
      "description": "Passport: key -> {value, unit, src, note}; src is a key of source."
    },
    "source": {
      "type": "object",
      "description": "Sources: key -> {doc, page, url, label}; label: fact, vendor, project, analog, assumption, calc."
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "thingIds this thing feeds with material."
    },
    "fed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "thingIds feeding this thing (inverse of feeds)."
    },
    "supplies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "thingIds supplied with power or water."
    },
    "ui": {
      "type": "object",
      "description": "Layout hints: scheme {col, row, span}."
    }
  }
}
