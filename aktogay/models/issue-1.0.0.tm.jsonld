{
  "@context": "https://www.w3.org/2022/wot/td/v1.1",
  "@type": "tm:ThingModel",
  "title": "Issue",
  "titles": {
    "en": "Issue",
    "ru": "Беда"
  },
  "description": "Created by akt-priority as issue-<n>; safety_class S0, S1 or empty. loss_usd_h is the rate once losses run, loss_from the model minute they start (-1: none expected, or a safety issue that is not counted in money). status_ru: the status in Russian words; person: the person twin to call. eta: expected arrival of the called person or crew; escalation: 'not arrived by ETA + 15 min' text (empty when none). States: OPEN, CALLED, IN_WORK, RESOLVED, SNOOZED.",
  "version": {
    "model": "1.0.0"
  },
