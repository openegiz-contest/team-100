  "properties": {
    "_parents": {
      "type": "string",
      "title": "Parent thing",
      "description": "thingId of the parent: the tree and the Telegraf tag parent."
    },
    "_isType": {
      "type": "boolean",
      "default": false,
      "description": "false: an instance, not a type (Grafana OpenTwins app)."
    },
    "type": {
      "type": "string",
      "description": "Thing type, same as the model file name.",
      "default": "issue"
    },
    "name": {
      "type": "string",
      "description": "Display name (Grafana OpenTwins app)."
    },
    "name_ru": {
      "type": "string",
      "description": "Name in Russian."
    },
    "passport": {
      "type": "object",
      "description": "Passport: key -> {value, unit, src, note}; src is a key of source."
    },
    "source": {
      "type": "object",
      "description": "Sources: key -> {doc, page, url, label}; label: fact, vendor, project, analog, assumption, calc."
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "thingIds this thing feeds with material."
    },
    "fed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "thingIds feeding this thing (inverse of feeds)."
    },
    "supplies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "thingIds supplied with power or water."
    },
    "ui": {
      "type": "object",
      "description": "Layout hints: scheme {col, row, span}."
    }
  }
}
